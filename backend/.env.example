# Occupancy estimator tuning (people_counter.py).
# Copy this file to ".env" (same folder) to override the built-in defaults.
# Real environment variables take precedence over this file.

# presence_score above this => at least one person present.
# NOTE: CSI presence is noisy; an empty room can read several points. Tune these
# to YOUR room with scripts/calibration_logger.py + calibration_analyzer.py.
PRESENCE_OCCUPIED=3.0

# presence_score above this => likely more than one person
PRESENCE_BUSY=6.0

# EMA smoothing weight for the newest reading (0..1); lower = smoother/slower.
# Lower this if the count jumps around too much.
SMOOTHING_ALPHA=0.4

# Seconds of no activity before the estimate starts decaying toward 0.
# Lower this if the count stays "stuck" too long after people leave.
DECAY_AFTER_SEC=8

# How much the smoothed estimate drops per inactive update.
DECAY_STEP=1.0

# Maximum reportable occupancy.
MAX_COUNT=5
